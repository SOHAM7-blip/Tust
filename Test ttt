local function trimMessages()
    local children = {}
    for _, c in pairs(ChatLog:GetChildren()) do
        if c:IsA("Frame") then table.insert(children, c) end
    end
    if #children > MAX_MESSAGES then
        table.sort(children, function(a, b)
            local ao = tonumber(a.LayoutOrder) or 0
            local bo = tonumber(b.LayoutOrder) or 0
            if ao ~= bo then return ao < bo end
            local as = tonumber(a:GetAttribute("PiratesInsertSeq")) or 0
            local bs = tonumber(b:GetAttribute("PiratesInsertSeq")) or 0
            return as < bs
        end)
        for i = 1, #children - MAX_MESSAGES do
            local c = children[i]
            if c and c.Parent then c:Destroy() end
        end
    end
end

