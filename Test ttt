local _firstLoadDone = false
local function fetchMessages()
    local ok = pcall(function()
        local res = fbReq({Url = DATABASE_URL..".json", Method = "GET"})
        if not res or not res.Body or res.Body == "null" then _firstLoadDone = true; return end
        local okJ, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not okJ or type(data) ~= "table" then return end

        local keys = {}
        for k, _ in pairs(data) do table.insert(keys, k) end
        table.sort(keys, function(a, b)
            local na = tonumber(a) or 0
            local nb = tonumber(b) or 0
            if na ~= nb then return na < nb end
            return tostring(a) < tostring(b)
        end)

        local isFirst = not _firstLoadDone
        local startIdx = isFirst and math.max(1, #keys - 24) or 1

        for i = startIdx, #keys do
            local key = keys[i]
            local msg = data[key]
            if not processedKeys[key] and type(msg) == "table" and msg.Content then
                processedKeys[key] = true
                local isSystem = msg.IsSystem or false
                local srv = msg.Server or ""
                if isSystem or srv == JobId or srv == "GLOBAL" or srv == "" then
                    local tgt = msg.TargetId
                    if not tgt or tgt == RealUserId or msg.SenderUid == RealUserId then
                        addMessage(msg.Sender or "Unknown", msg.Content, isSystem, tonumber(key) or 0, msg.SenderUid or 0, tgt ~= nil, isFirst, msg.ReplyTo)
                    end
                end
            end
        end
        _firstLoadDone = true
    end)
    if not ok then _firstLoadDone = true end
end

task.spawn(fetchMessages)
task.spawn(function()
    while task.wait(1.5) do
        if isKickedOrBanned then break end
        pcall(fetchMessages)
    end
end)

