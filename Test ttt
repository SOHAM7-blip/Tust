local function syncMusic()
    pcall(function()
        local res = fbReq({Url = MUSIC_URL.."/current.json", Method="GET"})
        if not res or not res.Body or res.Body == "null" then return end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if not ok or type(data) ~= "table" then return end
        if (data.timestamp or 0) <= LastMusicTimestamp then return end
        LastMusicTimestamp = data.timestamp or 0
        if data.action == "stop" then
            stopLocalMusic()
        elseif data.action == "play" and data.track then
            local trackData = data.track
            task.spawn(function()
                if _musicDownloading then return end
                _musicDownloading = true
                local streamUrl = trackData.streamUrl
                if not streamUrl then _musicDownloading = false; return end
                if MusicPlayer then
                    pcall(function() MusicPlayer:Stop() MusicPlayer:Destroy() end)
                    MusicPlayer = nil
                end
                if makefolder then pcall(makefolder, "pirates music") end
                local localAsset = nil
                local okDl, body = pcall(function()
                    local fn = request or http_request or (http and http.request) or (syn and syn.request)
                    if not fn then return nil end
                    local r = fn({Url = streamUrl, Method = "GET"})
                    return r and r.Body
                end)
                if okDl and body and #body > 10000 and writefile and getcustomasset then
                    local okWrite = pcall(writefile, "pirates music/music_listener.mp3", body)
                    if okWrite then
                        task.wait(0.15)
                        pcall(function()
                            localAsset = getcustomasset("pirates music/music_listener.mp3")
                        end)
                    end
                end
                if localAsset then
                    pcall(function()
                        MusicPlayer = Instance.new("Sound")
                        MusicPlayer.Parent = SoundService
                        MusicPlayer.Name = "PiratesMusicListener"
                        MusicPlayer.SoundId = localAsset
                        MusicPlayer.Volume = currentVolume
                        MusicPlayer:Play()
                        CurrentTrack = trackData
                    end)
                end
                _musicDownloading = false
            end)
        end
    end)
end

